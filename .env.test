# Test environment - loaded by pytest via pytest-dotenv
# Copy secrets from .env (not committed)
OPENROUTER_API_KEY=sk-or-v1-xxxx

# Test database (separate from dev database)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tradingagents_test
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tradingagents_test

# Disable SQL logging in tests for cleaner output
SQL_ECHO=false

# Test-specific settings
ONLINE_TOOLS=false
LLM_PROVIDER=openrouter
